# Database connection URL (Native PostgreSQL on Windows)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ruralcare"

# Server configuration
PORT=5000
NODE_ENV="development"

# Security & JWT configuration
JWT_SECRET="ruralcare_jwt_super_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins (comma-separated)
CORS_ORIGIN="http://localhost:8443,http://localhost:5173,http://localhost:3000"

# ABDM Integration Mode: "mock" (default for local demo) | "sandbox" | "production"
ABDM_MODE="mock"

# Official ABDM Gateway Developer Credentials (https://sandbox.abdm.gov.in/)
ABDM_CLIENT_ID="YOUR_ABDM_CLIENT_ID"
ABDM_CLIENT_SECRET="YOUR_ABDM_CLIENT_SECRET"
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway"

# Official UIDAI / Aadhaar e-KYC Gateway Credentials
UIDAI_AADHAAR_API_KEY="YOUR_UIDAI_AADHAAR_API_KEY"
UIDAI_ASA_LICENSE_KEY="YOUR_UIDAI_ASA_LICENSE_KEY"

